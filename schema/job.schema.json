{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation and cron checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "domain",
    "enabled",
    "schedule",
    "runtime",
    "inputs",
    "outputs",
    "output_format",
    "risk",
    "verification",
    "logging",
    "failure_policy",
    "secrets_policy",
    "limitations",
    "copying"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "schedule": {
      "type": "object",
      "required": [
        "cron",
        "timezone"
      ]
    },
    "runtime": {
      "type": "object",
      "required": [
        "scheduler",
        "execution_mode",
        "kind",
        "uses_llm",
        "model_attached",
        "model",
        "portable_to"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "minItems": 1
    },
    "output_format": {
      "type": "object",
      "required": [
        "delivery",
        "template",
        "exact_contract",
        "always_reports"
      ]
    },
    "risk": {
      "type": "object",
      "required": [
        "level",
        "confirmation"
      ]
    },
    "verification": {
      "type": "array",
      "minItems": 1
    },
    "logging": {
      "type": "object",
      "required": [
        "receipt",
        "retention",
        "business_verification_required"
      ]
    },
    "failure_policy": {
      "type": "object",
      "required": [
        "deliver_every_run",
        "mode",
        "never_infer_success"
      ]
    },
    "secrets_policy": {
      "type": "string",
      "minLength": 10
    },
    "limitations": {
      "type": "array",
      "minItems": 1
    },
    "copying": {
      "type": "object",
      "required": [
        "ready_to_run",
        "requires"
      ]
    }
  }
}
