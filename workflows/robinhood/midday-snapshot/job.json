{
  "schema_version": 1,
  "id": "robinhood.midday-snapshot",
  "title": "Robinhood midday snapshot",
  "domain": "robinhood",
  "enabled": true,
  "schedule": {
    "cron": "0 12 * * 1-5",
    "timezone": "America/Los_Angeles"
  },
  "runtime": {
    "kind": "agent",
    "uses_llm": true
  },
  "inputs": [
    "live portfolio/account/position/option reads",
    "current market context"
  ],
  "outputs": [
    "bounded current-session snapshot",
    "verified snapshot receipt"
  ],
  "risk": {
    "level": "read-only",
    "confirmation": "no trade or mutation is allowed"
  },
  "verification": [
    "all accounts reconcile",
    "day P&L is in dollars",
    "market and option timestamps are current-session",
    "snapshot artifact parses"
  ],
  "logging": {
    "receipt": "one bounded per-run receipt",
    "retention": "operator-defined local retention",
    "business_verification_required": true
  },
  "failure_policy": {
    "deliver_every_run": true,
    "mode": "fail-loud",
    "never_infer_success": true
  },
  "secrets_policy": "financial details remain private"
}
