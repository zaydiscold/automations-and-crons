{
  "schema_version": 2,
  "id": "robinhood.postmarket-summary",
  "title": "Robinhood postmarket summary",
  "domain": "robinhood",
  "enabled": true,
  "schedule": {
    "cron": "0 17 * * 1-5",
    "timezone": "America/Los_Angeles"
  },
  "runtime": {
    "scheduler": "Hermes Agent cron",
    "execution_mode": "agent",
    "kind": "agent",
    "uses_llm": true,
    "model_attached": true,
    "model": {
      "provider": "openai-codex",
      "name": "gpt-5.6-luna",
      "reasoning": "max",
      "fallback_policy": "inherits the scheduler-global chain",
      "fallbacks": [
        {
          "provider": "xai-oauth",
          "model": "grok-4.6"
        },
        {
          "provider": "openrouter",
          "model": "deepseek/deepseek-v4-flash"
        },
        {
          "provider": "openrouter",
          "model": "stealth/ox-alpha"
        },
        {
          "provider": "openrouter",
          "model": "openrouter/free"
        }
      ]
    },
    "portable_to": [
      "Hermes Agent cron",
      "another agent runner after rewriting the tool and prompt wiring"
    ]
  },
  "inputs": [
    "live close/after-hours account data",
    "current market context"
  ],
  "outputs": [
    "bounded close brief",
    "verified postmarket snapshot receipt"
  ],
  "risk": {
    "level": "read-only",
    "confirmation": "no trade or mutation is allowed"
  },
  "verification": [
    "regular and after-hours windows are labeled separately",
    "all accounts reconcile",
    "snapshot artifact parses",
    "tomorrow section uses verified catalysts only"
  ],
  "logging": {
    "receipt": "one bounded per-run receipt",
    "retention": "operator-defined local retention",
    "business_verification_required": true
  },
  "failure_policy": {
    "deliver_every_run": true,
    "mode": "fail-loud",
    "never_infer_success": true
  },
  "secrets_policy": "financial details remain private",
  "output_format": {
    "delivery": "Telegram Markdown",
    "template": "output.md",
    "exact_contract": true,
    "always_reports": true
  },
  "limitations": [
    "This is a current-session close report, not a historical scorecard.",
    "The private brokerage client, account labels, snapshot code, and live portfolio values are not included.",
    "Regular-session and after-hours numbers can use different windows and must stay labeled separately."
  ],
  "copying": {
    "ready_to_run": false,
    "requires": [
      "a live all-account brokerage data source",
      "a snapshot writer",
      "a delivery target",
      "a model/tool runner if keeping agent mode"
    ]
  }
}
