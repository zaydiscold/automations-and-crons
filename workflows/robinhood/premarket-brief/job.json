{
  "schema_version": 2,
  "id": "robinhood.premarket-brief",
  "title": "Robinhood premarket brief",
  "domain": "robinhood",
  "enabled": true,
  "schedule": {
    "cron": "0 6 * * 1-5",
    "timezone": "America/Los_Angeles"
  },
  "runtime": {
    "scheduler": "Hermes Agent cron",
    "execution_mode": "agent",
    "kind": "agent",
    "uses_llm": true,
    "model_attached": true,
    "model": {
      "provider": "openai-codex",
      "name": "gpt-5.6-luna",
      "reasoning": "max",
      "fallback_policy": "inherits the scheduler-global chain",
      "fallbacks": [
        {
          "provider": "xai-oauth",
          "model": "grok-4.6"
        },
        {
          "provider": "openrouter",
          "model": "deepseek/deepseek-v4-flash"
        },
        {
          "provider": "openrouter",
          "model": "stealth/ox-alpha"
        },
        {
          "provider": "openrouter",
          "model": "openrouter/free"
        }
      ]
    },
    "portable_to": [
      "Hermes Agent cron",
      "another agent runner after rewriting the tool and prompt wiring"
    ]
  },
  "inputs": [
    "live portfolio/account/position/option reads",
    "current market context"
  ],
  "outputs": [
    "bounded current-session brief",
    "verified snapshot receipt"
  ],
  "risk": {
    "level": "read-only",
    "confirmation": "no trade or mutation is allowed"
  },
  "verification": [
    "all owned accounts reconcile",
    "dollar P&L is used instead of size-blind ranking",
    "snapshot artifact parses",
    "title date and runtime footer match contract"
  ],
  "logging": {
    "receipt": "one bounded per-run receipt",
    "retention": "operator-defined local retention",
    "business_verification_required": true
  },
  "failure_policy": {
    "deliver_every_run": true,
    "mode": "fail-loud",
    "never_infer_success": true
  },
  "secrets_policy": "financial details remain in private receipts; templates contain no values",
  "output_format": {
    "delivery": "Telegram Markdown",
    "template": "output.md",
    "exact_contract": true,
    "always_reports": true
  },
  "limitations": [
    "This is a reporting job, not investment advice and not a trading bot.",
    "The private brokerage client, account labels, snapshot code, and live portfolio values are not included.",
    "Market explanations need current broker data or current primary sources; the model is not evidence."
  ],
  "copying": {
    "ready_to_run": false,
    "requires": [
      "a live all-account brokerage data source",
      "a snapshot writer",
      "a delivery target",
      "a model/tool runner if keeping agent mode"
    ]
  }
}
