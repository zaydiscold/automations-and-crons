{
  "schema_version": 2,
  "id": "robinhood.token-refresh",
  "title": "Robinhood token refresh",
  "domain": "robinhood",
  "enabled": true,
  "schedule": {
    "cron": "0 4 */3 * *",
    "timezone": "America/Los_Angeles"
  },
  "runtime": {
    "scheduler": "Hermes Agent cron",
    "execution_mode": "agent",
    "kind": "agent",
    "uses_llm": true,
    "model_attached": true,
    "model": {
      "provider": "openai-codex",
      "name": "gpt-5.6-luna",
      "reasoning": "max",
      "fallback_policy": "inherits the scheduler-global chain",
      "fallbacks": [
        {
          "provider": "xai-oauth",
          "model": "grok-4.6"
        },
        {
          "provider": "openrouter",
          "model": "deepseek/deepseek-v4-flash"
        },
        {
          "provider": "openrouter",
          "model": "stealth/ox-alpha"
        },
        {
          "provider": "openrouter",
          "model": "openrouter/free"
        }
      ]
    },
    "portable_to": [
      "Hermes Agent cron",
      "another agent runner after rewriting the tool and prompt wiring"
    ]
  },
  "inputs": [
    "freshest locally authorized browser-session candidate"
  ],
  "outputs": [
    "redacted auth-health receipt"
  ],
  "risk": {
    "level": "auth-write",
    "confirmation": "standing approval limited to refreshing the existing local session"
  },
  "verification": [
    "authenticated account-list read succeeds",
    "expected account count is not truncated",
    "no token appears in output or argv"
  ],
  "logging": {
    "receipt": "one bounded per-run receipt",
    "retention": "operator-defined local retention",
    "business_verification_required": true
  },
  "failure_policy": {
    "deliver_every_run": true,
    "mode": "fail-loud",
    "never_infer_success": true
  },
  "secrets_policy": "tokens stay in protected local files and process environment",
  "output_format": {
    "delivery": "Telegram Markdown",
    "template": "output.md",
    "exact_contract": true,
    "always_reports": true
  },
  "limitations": [
    "This depends on a custom Robinhood client and an already-authorized browser session; the official trading MCP is not a substitute.",
    "A reachable token file is not proof of valid auth; the job needs a successful authenticated account read.",
    "The machine-to-machine browser and filesystem paths are intentionally not included."
  ],
  "copying": {
    "ready_to_run": false,
    "requires": [
      "a custom read-capable Robinhood client",
      "an authorized browser-session source",
      "protected secret storage",
      "a cross-machine transport if auth is harvested elsewhere"
    ]
  }
}
